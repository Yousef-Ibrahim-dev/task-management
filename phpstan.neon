includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    # Without this Larastan reads the declared return type of casts() instead of
    # its body, so enum casts are seen as plain strings.
    parseModelCastsMethod: true

    paths:
        - app
        - config
        - database
        - routes

    tmpDir: storage/framework/cache/phpstan
